@inproceedings{van_der_hoeven_comparator-adaptive_2020,
	address = {Red Hook, NY, USA},
	series = {{NIPS} '20},
	title = {Comparator-adaptive convex bandits},
	isbn = {978-1-7138-2954-6},
	abstract = {We study bandit convex optimization methods that adapt to the norm of the comparator, a topic that has only been studied before for its full-information counterpart. Specifically, we develop convex bandit algorithms with regret bounds that are small whenever the norm of the comparator is small. We first use techniques from the full-information setting to develop comparator-adaptive algorithms for linear bandits. Then, we extend the ideas to convex bandits with Lipschitz or smooth loss functions, using a new variant of the standard single-point gradient estimator and carefully designed surrogate losses.},
	urldate = {2025-09-23},
	booktitle = {Proceedings of the 34th {International} {Conference} on {Neural} {Information} {Processing} {Systems}},
	publisher = {Curran Associates Inc.},
	author = {van der Hoeven, Dirk and Cutkosky, Ashok and Luo, Haipeng},
	month = dec,
	year = {2020},
	pages = {19795--19804},
}

@article{xiao_fast_2004,
	title = {Fast linear iterations for distributed averaging},
	volume = {53},
	issn = {0167-6911},
	url = {https://www.sciencedirect.com/science/article/pii/S0167691104000398},
	doi = {10.1016/j.sysconle.2004.02.022},
	abstract = {We consider the problem of finding a linear iteration that yields distributed averaging consensus over a network, i.e., that asymptotically computes the average of some initial values given at the nodes. When the iteration is assumed symmetric, the problem of finding the fastest converging linear iteration can be cast as a semidefinite program, and therefore efficiently and globally solved. These optimal linear iterations are often substantially faster than several common heuristics that are based on the Laplacian of the associated graph. We show how problem structure can be exploited to speed up interior-point methods for solving the fastest distributed linear iteration problem, for networks with up to a thousand or so edges. We also describe a simple subgradient method that handles far larger problems, with up to 100000 edges. We give several extensions and variations on the basic problem.},
	number = {1},
	urldate = {2025-09-23},
	journal = {Systems \& Control Letters},
	author = {Xiao, Lin and Boyd, Stephen},
	month = sep,
	year = {2004},
	keywords = {Distributed consensus, Graph Laplacian, Linear system, Semidefinite programming, Spectral radius},
	pages = {65--78},
}

