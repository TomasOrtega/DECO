@article{tikale_towards_2025,
	title = {Towards {Decentralized} {Governance} of {Scarce} {Resources}: {Water} as {Proving} {Ground}},
	abstract = {This paper presents a vision for transforming essential resource management through Decentralized Physical Infrastructure Networks (DePIN). We examine the limitations of centralized systems and propose a framework built on distributed sensing, incentivized data sharing, and blockchain governance. Using water as our case study, we offer an approach to democratizing monitoring and management of a scarce common pool resource by integrating flow sensing, quality monitoring, and a decentralized analytics platform. We address key challenges of sensing accuracy and scalability, privacy concerns, network bootstrapping, and ecosystem sustainability. Our analysis reveals a \$40+ billion market potential in household water monitoring. The proposed approach benefits individuals, communities, enterprises, and governments by enabling sustainable, transparent, and equitable resource management—applicable not only to water but also to power, gas, and internet infrastructure.},
	language = {en},
	journal = {5th International Workshop on Distributed Infrastructure for Common Good co-located with IEEE ICDCS 2025},
	author = {Tikale, Sahil and Banerjee, Avishek and Khmaissia, Fadoua and Ravi, Nirupama},
	year = {2025},
}

