	note = {ISSN: 0191-2216},
	keywords = {Communication system control, Convergence of numerical methods, Cost function, Distributed algorithms, Network topology, Parameter estimation, Peer to peer computing, Resource management, USA Councils, Wireless sensor networks},
	pages = {4705--4710},
}

