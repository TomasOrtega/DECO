@inproceedings{bertsekas_convergence_1989,
	address = {Crete, Greece},
	title = {Convergence rate and termination of asynchronous iterative algorithms},
	copyright = {https://www.acm.org/publications/policies/copyright\_policy\#Background},
	isbn = {978-0-89791-309-6},
	url = {http://portal.acm.org/citation.cfm?doid=318789.318894},
