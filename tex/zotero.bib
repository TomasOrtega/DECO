@article{dumer_covering_2007,
	title = {Covering {Spheres} with {Spheres}},
	volume = {38},
	issn = {1432-0444},
	url = {https://doi.org/10.1007/s00454-007-9000-7},
	doi = {10.1007/s00454-007-9000-7},
	abstract = {Given a sphere of any radius r in an n-dimensional Euclidean space, we study the coverings of this sphere with solid spheres of radius one. Our goal is to design a covering of the lowest covering density, which defines the average number of solid spheres covering a point in a bigger sphere. For growing dimension n, we design a covering that gives the covering density of order (nln n)/2 for a sphere of any radius r{\textgreater}1 and a complete Euclidean space. This new upper bound reduces two times the order nln n established in the classic Rogers bound.},
