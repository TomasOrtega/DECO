@inproceedings{koloskova_decentralized_2019,
	title = {Decentralized {Stochastic} {Optimization} and {Gossip} {Algorithms} with {Compressed} {Communication}},
	url = {https://proceedings.mlr.press/v97/koloskova19a.html},
	abstract = {We consider decentralized stochastic optimization with the objective function (e.g. data samples for machine learning tasks) being distributed over n machines that can only communicate to their neighbors on a fixed communication graph. To address the communication bottleneck, the nodes compress (e.g. quantize or sparsify) their model updates. We cover both unbiased and biased compression operators with quality denoted by {\textbackslash}delta {\textless}= 1 ({\textbackslash}delta=1 meaning no compression). We (i) propose a novel gossip-based stochastic gradient descent algorithm, CHOCO-SGD, that converges at rate O(1/(nT) + 1/(T {\textbackslash}rho{\textasciicircum}2 {\textbackslash}delta){\textasciicircum}2) for strongly convex objectives, where T denotes the number of iterations and {\textbackslash}rho the eigengap of the connectivity matrix. We (ii) present a novel gossip algorithm, CHOCO-GOSSIP, for the average consensus problem that converges in time O(1/({\textbackslash}rho{\textasciicircum}2{\textbackslash}delta) {\textbackslash}log (1/{\textbackslash}epsilon)) for accuracy {\textbackslash}epsilon {\textgreater} 0. This is (up to our knowledge) the first gossip algorithm that supports arbitrary compressed messages for {\textbackslash}delta {\textgreater} 0 and still exhibits linear convergence. We (iii) show in experiments that both of our algorithms do outperform the respective state-of-the-art baselines and CHOCO-SGD can reduce communication by at least two orders of magnitudes.},
	language = {en},
	urldate = {2022-10-03},
	booktitle = {Proceedings of the 36th {International} {Conference} on {Machine} {Learning}},
	publisher = {PMLR},
	author = {Koloskova, Anastasia and Stich, Sebastian and Jaggi, Martin},
	month = may,
	year = {2019},
	note = {ISSN: 2640-3498},
	keywords = {Read},
	pages = {3478--3487},
}

