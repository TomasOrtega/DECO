@article{pepe_small_2009,
	title = {Small weight codewords in the {LDPC} codes arising from linear representations of geometries},
	volume = {17},
	issn = {15206610},
	doi = {10.1002/jcd.20179},
	abstract = {In this article, we investigate the minimum distance and small weight codewords of the LDPC codes of linear representations, using only geometrical methods. First, we present a new lower bound on the minimum distance and we present a number of cases in which this lower bound is sharp. Then we take a closer look at the cases T*2(Θ) and T*2(Θ)Dwith Θ a hyperoval, hence q even, and characterize codewords of small weight. When investigating the small weight codewords of T*2(Θ)D, we deal with the case of Θ a regular hyperoval, that is, a conic and its nucleus, separately, since in this case, we have a larger upper bound on the weight for which the results are valid. © 2008 Wiley Periodicals, Inc.},
